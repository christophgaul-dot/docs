<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>QR-Rechnung Einstellungen</title>
        <title lang="en-GB">QR Bill Settings</title>

        <input-field type="text">
            <name>qrIban</name>
            <label>QR-IBAN</label>
            <label lang="en-GB">QR-IBAN</label>
            <helpText>QR-IBAN Ihres Geschäftskontos (z.B. CH44 3199 9123 0008 8901 2)</helpText>
            <placeholder>CH44 3199 9123 0008 8901 2</placeholder>
        </input-field>

        <input-field type="text">
            <name>creditorName</name>
            <label>Firmenname (Zahlungsempfänger)</label>
            <label lang="en-GB">Company name (payee)</label>
            <placeholder>WENK Socken GmbH</placeholder>
        </input-field>

        <input-field type="text">
            <name>creditorStreet</name>
            <label>Strasse und Hausnummer</label>
            <label lang="en-GB">Street and number</label>
            <placeholder>Musterstrasse 1</placeholder>
        </input-field>

        <input-field type="text">
            <name>creditorZip</name>
            <label>PLZ</label>
            <label lang="en-GB">Postal code</label>
            <placeholder>4600</placeholder>
        </input-field>

        <input-field type="text">
            <name>creditorCity</name>
            <label>Ort</label>
            <label lang="en-GB">City</label>
            <placeholder>Olten</placeholder>
        </input-field>

        <input-field type="single-select">
            <name>creditorCountry</name>
            <label>Land</label>
            <label lang="en-GB">Country</label>
            <defaultValue>CH</defaultValue>
            <options>
                <option>
                    <id>CH</id>
                    <name>Schweiz</name>
                    <name lang="en-GB">Switzerland</name>
                </option>
                <option>
                    <id>LI</id>
                    <name>Liechtenstein</name>
                    <name lang="en-GB">Liechtenstein</name>
                </option>
            </options>
        </input-field>

        <input-field type="single-select">
            <name>referenceType</name>
            <label>Referenz-Typ</label>
            <label lang="en-GB">Reference type</label>
            <helpText>QRR: QR-Referenz (27 Ziffern, benötigt QR-IBAN). SCOR: Creditor Reference (ISO 11649, mit normaler IBAN).</helpText>
            <defaultValue>QRR</defaultValue>
            <options>
                <option>
                    <id>QRR</id>
                    <name>QR-Referenz (QRR)</name>
                </option>
                <option>
                    <id>SCOR</id>
                    <name>Creditor Reference (SCOR)</name>
                </option>
            </options>
        </input-field>
    </card>

    <card>
        <title>Mahnwesen</title>
        <title lang="en-GB">Dunning</title>

        <input-field type="int">
            <name>dunningDays</name>
            <label>Zahlungsfrist (Tage)</label>
            <label lang="en-GB">Payment deadline (days)</label>
            <helpText>Anzahl Tage nach Rechnungsdatum bis zur ersten Mahnung</helpText>
            <defaultValue>30</defaultValue>
        </input-field>

        <input-field type="float">
            <name>dunningFee1</name>
            <label>Mahngebühr Stufe 1 (CHF)</label>
            <label lang="en-GB">Dunning fee level 1 (CHF)</label>
            <defaultValue>0</defaultValue>
        </input-field>

        <input-field type="float">
            <name>dunningFee2</name>
            <label>Mahngebühr Stufe 2 (CHF)</label>
            <label lang="en-GB">Dunning fee level 2 (CHF)</label>
            <defaultValue>10</defaultValue>
        </input-field>

        <input-field type="float">
            <name>dunningFee3</name>
            <label>Mahngebühr Stufe 3 (CHF)</label>
            <label lang="en-GB">Dunning fee level 3 (CHF)</label>
            <defaultValue>20</defaultValue>
        </input-field>
    </card>
</config>
