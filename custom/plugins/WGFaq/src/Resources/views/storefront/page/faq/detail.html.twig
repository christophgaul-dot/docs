{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}
    <title>{{ faq.translated.metaTitle ?: faq.translated.question }} | {{ page.header.shop.name }}</title>
    {% if faq.translated.metaDescription %}
        <meta name="description" content="{{ faq.translated.metaDescription }}" />
    {% endif %}
    <link rel="canonical" href="{{ seoUrl('frontend.wg.faq.detail', { faqId: faq.id }) }}" />
{% endblock %}

{% block base_main_inner %}
    <div class="container cms-page">
        <div class="row">
            <div class="col-12">
                {% block wg_faq_detail_breadcrumb %}
                    <nav aria-label="breadcrumb" class="mb-3">
                        <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
                            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="{{ path('frontend.home.page') }}" itemprop="item">
                                    <span itemprop="name">{{ "general.homeLink"|trans|sw_sanitize }}</span>
                                </a>
                                <meta itemprop="position" content="1" />
                            </li>
                            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="{{ path('frontend.wg.faq.index') }}" itemprop="item">
                                    <span itemprop="name">{{ "wg-faq.pageTitle"|trans|sw_sanitize }}</span>
                                </a>
                                <meta itemprop="position" content="2" />
                            </li>
                            <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <span itemprop="name">{{ faq.translated.question }}</span>
                                <meta itemprop="position" content="3" />
                            </li>
                        </ol>
                    </nav>
                {% endblock %}

                {% block wg_faq_detail_content %}
                    {% block wg_faq_detail_schema %}
                        {# Schema.org FAQPage Markup for single question #}
                        <script type="application/ld+json">
                        {
                            "@context": "https://schema.org",
                            "@type": "FAQPage",
                            "mainEntity": [{
                                "@type": "Question",
                                "name": {{ faq.translated.question|json_encode|raw }},
                                "acceptedAnswer": {
                                    "@type": "Answer",
                                    "text": {{ faq.translated.answer|striptags|json_encode|raw }}
                                }
                            }]
                        }
                        </script>
                    {% endblock %}

                    <article class="wg-faq-detail" itemscope itemtype="https://schema.org/Article">
                        {% block wg_faq_detail_question %}
                            <h1 class="wg-faq-detail-question mb-4" itemprop="headline">{{ faq.translated.question }}</h1>
                        {% endblock %}

                        {% block wg_faq_detail_media %}
                            {% if faq.media %}
                                <div class="wg-faq-detail-media mb-4">
                                    <img src="{{ faq.media.url }}"
                                         alt="{{ faq.translated.question }}"
                                         class="img-fluid rounded"
                                         loading="lazy"
                                         width="{{ faq.media.metaData.width|default('') }}"
                                         height="{{ faq.media.metaData.height|default('') }}"
                                         itemprop="image" />
                                </div>
                            {% endif %}
                        {% endblock %}

                        {% block wg_faq_detail_answer %}
                            <div class="wg-faq-detail-answer" itemprop="articleBody">
                                {{ faq.translated.answer|raw }}
                            </div>
                        {% endblock %}

                        {% block wg_faq_detail_video %}
                            {% if faq.videoUrl %}
                                <div class="wg-faq-detail-video mt-4">
                                    {% if faq.videoType == 'youtube' %}
                                        {% set videoId = faq.videoUrl|replace({'https://www.youtube.com/watch?v=': '', 'https://youtube.com/watch?v=': '', 'https://www.youtube.com/embed/': '', 'https://youtu.be/': ''}) %}
                                        <div class="ratio ratio-16x9">
                                            <iframe src="https://www.youtube-nocookie.com/embed/{{ videoId }}"
                                                    title="{{ faq.translated.question }}"
                                                    allowfullscreen
                                                    loading="lazy"
                                                    referrerpolicy="no-referrer"></iframe>
                                        </div>
                                    {% else %}
                                        <div class="ratio ratio-16x9">
                                            <iframe src="{{ faq.videoUrl }}"
                                                    title="{{ faq.translated.question }}"
                                                    allowfullscreen
                                                    loading="lazy"
                                                    referrerpolicy="no-referrer"></iframe>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endblock %}
                    </article>

                    {% block wg_faq_detail_back_link %}
                        <div class="mt-4">
                            <a href="{{ path('frontend.wg.faq.index') }}" class="btn btn-outline-primary">
                                &larr; {{ "wg-faq.backToOverview"|trans|sw_sanitize }}
                            </a>
                        </div>
                    {% endblock %}
                {% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
