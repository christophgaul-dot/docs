<sw-page class="wg-faq-list">
    <template #smart-bar-header>
        <h2>{{ $tc('wg-faq.list.title') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button
            variant="ghost"
            :isLoading="isExporting"
            @click="onExport">
            <sw-icon name="regular-download" small></sw-icon>
            {{ $tc('wg-faq.list.buttonExport') }}
        </sw-button>

        <sw-button
            variant="ghost"
            @click="onOpenImport">
            <sw-icon name="regular-upload" small></sw-icon>
            {{ $tc('wg-faq.list.buttonImport') }}
        </sw-button>

        <sw-button
            :routerLink="{ name: 'wg.faq.create' }"
            variant="primary">
            {{ $tc('wg-faq.list.buttonCreate') }}
        </sw-button>
    </template>

    <template #content>
        <!-- Import Modal -->
        <sw-modal
            v-if="showImportModal"
            :title="$tc('wg-faq.list.importTitle')"
            @modal-close="showImportModal = false">

            <div class="wg-faq-import-modal">
                <p>{{ $tc('wg-faq.list.importDescription') }}</p>

                <sw-file-input
                    accept="application/json,.json"
                    :label="$tc('wg-faq.list.importFileLabel')"
                    @change="onImportFileSelected">
                </sw-file-input>

                <sw-alert v-if="importResult" :variant="importResult.success ? 'success' : 'warning'">
                    {{ importResult.message }}
                    <template v-if="importResult.errors && importResult.errors.length">
                        <ul style="margin-top: 8px;">
                            <li v-for="error in importResult.errors" :key="error">{{ error }}</li>
                        </ul>
                    </template>
                </sw-alert>
            </div>

            <template #modal-footer>
                <sw-button
                    variant="ghost"
                    @click="showImportModal = false">
                    {{ $tc('wg-faq.list.importClose') }}
                </sw-button>
                <sw-button
                    variant="primary"
                    :isLoading="isImporting"
                    :disabled="!importFile"
                    @click="onImport">
                    {{ $tc('wg-faq.list.importStart') }}
                </sw-button>
            </template>
        </sw-modal>

        <sw-entity-listing
            v-if="faqs"
            :items="faqs"
            :repository="faqRepository"
            :columns="faqColumns"
            :isLoading="isLoading"
            :showSelection="true"
            :allowEdit="true"
            :allowDelete="true"
            detail-route="wg.faq.detail"
            @delete-item-finish="getList">

            <template #column-active="{ item }">
                <sw-icon v-if="item.active" name="regular-checkmark-xs" small class="is--active"></sw-icon>
                <sw-icon v-else name="regular-times-xs" small class="is--inactive"></sw-icon>
            </template>

            <template #column-showOn="{ item }">
                {{ getShowOnLabels(item) }}
            </template>

        </sw-entity-listing>
    </template>
</sw-page>
