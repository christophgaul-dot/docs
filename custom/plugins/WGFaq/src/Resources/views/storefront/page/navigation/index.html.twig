{% sw_extends '@Storefront/storefront/page/navigation/index.html.twig' %}

{# Inject FAQs on navigation pages (categories + homepage) #}
{% block cms_page %}
    {{ parent() }}

    {% if page.extensions.wgFaqs is defined and page.extensions.wgFaqs|length > 0 %}
        <div class="container">
            {% sw_include '@WGFaq/storefront/component/faq-accordion.html.twig' with {
                faqs: page.extensions.wgFaqs,
                faqTitle: "wg-faq.sectionTitle"|trans,
                accordionId: 'navigation',
                showDetailLink: false
            } %}
        </div>
    {% endif %}
{% endblock %}
